// Formation slots in normalised block coordinates, team frame (attacking +x; +y = left side).
// depth: 0 = back line, 1 = front line of the block. width: -1 = right touchline side, +1 = left.
// `out_pos` = out-of-possession shape (here 4-1-4-1), `in_pos` = in-possession shape (2-3-5-like 4-3-3).
// Roles (docs/player-brain.md 5.3): GK, CB×2, FB×2, DM, CM8×2, W×2, CF; the wingers defend as wide midfielders (4-5-1).
// BU-02: full-backs are wide outlets in possession; ATT-10: central midfielders staggered.
(
    name: "4-3-3",
    slots: [
        (role: GK, label: "GK",  out_pos: (0.0, 0.0),   in_pos: (0.0, 0.0)),
        (role: FB, label: "RB",  out_pos: (0.0, -1.00), in_pos: (0.38, -1.00)),
        (role: CB, label: "RCB", out_pos: (0.0, -0.35),  in_pos: (0.0, -0.42)),
        (role: CB, label: "LCB", out_pos: (0.0, 0.35),   in_pos: (0.0, 0.42)),
        (role: FB, label: "LB",  out_pos: (0.0, 1.00),  in_pos: (0.38, 1.00)),
